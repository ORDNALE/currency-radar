{
  "manifest_version": 3,
  "name": "Currency Radar",
  "version": "0.1.0",
  "description": "Analisa o histórico de câmbio e indica oportunidades de compra.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Currency Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
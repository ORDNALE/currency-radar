{
  "manifest_version": 3,
  "name": "Currency Radar",
  "version": "0.1.0",
  "description": "Analisa o histórico de câmbio e indica oportunidades de compra.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Currency Radar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}